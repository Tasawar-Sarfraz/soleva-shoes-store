{
  "name": "soleva-shoes-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "assets": "tsx scripts/assets.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@splinetool/react-spline": "4.1.0",
    "@splinetool/runtime": "2.0.79",
    "aframe": "1.8.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "12.11.1",
    "cesium": "1.146.0",
    "drizzle-orm": "0.45.4",
    "gl-matrix": "3.4.4",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "dotenv": "^17.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
